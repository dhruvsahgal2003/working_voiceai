# ─── SERVER ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PLIVO ────────────────────────────────────────────
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_FROM_NUMBER=+91XXXXXXXXXX       # Your Indian DID number from Plivo
PLIVO_AI_AGENT_ID=your_plivo_agent_id # Agent ID from Plivo AI Agent dashboard

# ─── SUPABASE ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ─── APP ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
WEBHOOK_BASE_URL=https://your-backend-url.railway.app  # Public URL for Plivo webhooks

# ─── NOTIFICATIONS (optional) ─────────────────────────
# WhatsApp notification for hot leads (using Plivo WhatsApp)
SALES_TEAM_WHATSAPP=+91XXXXXXXXXX

# ─── WHATSAPP INBOX (single-client MVP) ────────────────
# Which Callora user inbound/outbound WhatsApp messages belong to.
WHATSAPP_USER_ID=

# ─── REDIS (campaign call queue) ───────────────────────
# Required — campaign dialing is a BullMQ queue backed by Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CAMPAIGN_QUEUE_CONCURRENCY=8  # platform-wide cap on simultaneous call-placement steps
